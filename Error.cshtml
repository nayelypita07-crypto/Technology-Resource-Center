@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Se produjo un error al procesar tu solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Al cambiar al entorno de <strong>Desarrollo</strong>, se mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno de Desarrollo no debe habilitarse en aplicaciones implementadas en producción.</strong>
    Esto puede provocar que se muestre información confidencial de las excepciones a los usuarios finales.
    Para la depuración local, habilita el entorno de <strong>Desarrollo</strong> estableciendo la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong>
    y reiniciando la aplicación.
</p>
