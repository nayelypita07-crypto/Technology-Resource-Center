@model IEnumerable<TechnologyResourceCenter.Models.Accessory>

@{
    ViewData["Title"] = "Accesorios por categoría";
    var groups = Model
        .GroupBy(a => a.Category)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="container py-4">
    <h1>Accesorios por categoría</h1>
    <p class="text-muted">Accesorios organizados por categorías tecnológicas.</p>

    @foreach (var group in groups)
    {
        <section class="mb-5">
            <h2 class="h4 mb-3">
                <span class="badge bg-primary">@group.Key</span>
                <span class="text-muted fs-6">(@group.Count() artículos)</span>
            </h2>

            <div class="row g-3">
                @foreach (var item in group)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5>@item.Name</h5>
                                <p><strong>Marca:</strong> @item.Brand</p>
                                <p>
                                    <strong>Precio:</strong> @item.Price.ToString("C2",
                                         System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                </p>
                                <p><strong>Cantidad:</strong> @item.Quantity</p>
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-outline-primary">Ver detalles</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <a asp-action="Index" class="btn btn-secondary">Volver a los accesorios</a>
</div>
