
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Centro de Recursos Tecnológicos</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                Centro de Recursos Tecnológicos
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">Inicio</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Equipment"
                           asp-action="Index">Equipos</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Spaces"
                           asp-action="Index">Espacios</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Kits"
                           asp-action="Index">Kits</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Accessories"
                           asp-action="Index">Accesorios</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-3">
        <div class="container">
            Centro de Recursos Tecnológicos &copy; @DateTime.Now.Year
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
