@model IEnumerable<TechnologyResourceCenter.Models.Space>

@{
    ViewData["Title"] = "Espacios tecnológicos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Espacios tecnológicos</h1>
            <p class="text-muted">Explora nuestras instalaciones tecnológicas.</p>
        </div>
        <a asp-action="Available" class="btn btn-success">Espacios disponibles</a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p><strong>Ubicación:</strong> @item.Location</p>
                        <p><strong>Capacidad:</strong> @item.Capacity personas</p>
                        <p>
                            <strong>Tarifa por hora:</strong> @item.HourlyRate.ToString("C2",
                                System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                        </p>

                        @if (item.IsAvailable)
                        {
                            <span class="badge bg-success">DISPONIBLE</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">NO DISPONIBLE</span>
                        }

                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-primary">Ver detalles</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
