@model IEnumerable<TechnologyResourceCenter.Models.Kit>

@{
    ViewData["Title"] = "Kits por nivel";
    var levels = new[] { "BEGINNER", "INTERMEDIATE", "ADVANCED" };
}

<div class="container py-4">
    <h1>Kits tecnológicos por nivel</h1>
    <p class="text-muted">Explore los kits agrupados por nivel de dificultad de aprendizaje.</p>

    @foreach (var level in levels)
    {
        var levelKits = Model.Where(k => k.Level == level).ToList();

        <section class="mb-5">
            <h2 class="h4 mb-3">
                @if (level == "BEGINNER")
                {
                    <span class="badge bg-success">PRINCIPIANTE</span>
                }
                else if (level == "INTERMEDIATE")
                {
                    <span class="badge bg-warning text-dark">INTERMEDIO</span>
                }
                else
                {
                    <span class="badge bg-danger">AVANZADO</span>
                }
            </h2>

            @if (!levelKits.Any())
            {
                <p class="text-muted">No hay kits en este nivel.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in levelKits)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5>@item.Name</h5>
                                    <p><strong>Categoría:</strong> @item.Category</p>
                                    <p><strong>Cantidad:</strong> @item.Quantity</p>
                                    <p><strong>Estado:</strong> @item.GetStatus()</p>
                                    <p>
                                        <strong>Tarifa diaria:</strong> @item.DailyRate.ToString("C2",
                                             System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                    </p>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-primary">Ver detalles</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }

    <a asp-action="Index" class="btn btn-secondary">Volver a los kits</a>
</div>
